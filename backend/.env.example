PORT=5000
NODE_ENV=development

# ----- Firebase Credentials -----
# LOCAL DEV: point to the JSON key file (never commit the actual file)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# PRODUCTION (Railway / Docker): paste the entire JSON content as a single-line string
# Leave blank in local dev — the file path above will be used instead
FIREBASE_SERVICE_ACCOUNT_JSON=

# ----- CORS -----
# Local dev
FRONTEND_URL=http://localhost:5173
# Production example:
# FRONTEND_URL=https://yourapp.tech
